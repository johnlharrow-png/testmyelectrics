# Railway sets $PORT; Railway terminates HTTPS in front of this.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Assets carry ?v= version numbers in index.html, so they can be cached; the page itself can't.
	header /assets/* Cache-Control "public, max-age=604800"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Callback form: the browser posts to /api/lead on this site and Caddy forwards it to the
	# booking app's public lead endpoint (brief section 05: "call them from the website's server").
	handle /api/lead {
		request_body {
			max_size 32KB
		}
		rewrite * /api/public/lead
		reverse_proxy https://book.testmyelectrics.com {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		# /terms, /privacy, /complaints -> terms.html etc.
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
